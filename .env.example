# AI Chat 本地开发环境变量模板
# 使用方式：复制为 ".env" 后再启动项目
# 说明：
# 1. 示例密钥和示例密码只适合本地开发，不能直接用于生产环境
# 2. 留空通常表示"可选"或"关闭"，除非注释里另有说明
# 3. API_BASE_URL 必须填写到版本层，例如 https://example.com/v1

# -----------------------------------------------------------------------------
# 默认上游模型接口
# -----------------------------------------------------------------------------
API_BASE_URL=https://api.example.com/v1
API_KEY=demo-key-change-me

# -----------------------------------------------------------------------------
# HTTP 服务监听
# -----------------------------------------------------------------------------
HOST=0.0.0.0
PORT=3000

# 图文消息会增大请求体，默认建议保留 15mb
EXPRESS_JSON_LIMIT=15mb

# -----------------------------------------------------------------------------
# 默认管理员账号
# -----------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=demo-admin-password-change-me

# -----------------------------------------------------------------------------
# 登录会话与安全
# -----------------------------------------------------------------------------
# 默认 8 小时
SESSION_TTL_MS=28800000

# 本地如果通过 HTTP 访问，请保持 false
SESSION_COOKIE_SECURE=false

# -----------------------------------------------------------------------------
# 运行时数据文件
# -----------------------------------------------------------------------------
RUNTIME_CONFIG_PATH=.runtime-config.json
USERS_CONFIG_PATH=.runtime-users.json
ANNOUNCEMENTS_CONFIG_PATH=.runtime-announcements.json
CONVERSATIONS_CONFIG_PATH=.runtime-conversations.json

MAX_STORED_ANNOUNCEMENTS=80
MAX_STORED_CONVERSATIONS_PER_USER=120
MAX_MESSAGES_PER_CONVERSATION=320
MAX_CONVERSATION_MESSAGE_LENGTH=12000
MAX_CONVERSATION_SYSTEM_PROMPT_LENGTH=6000

# -----------------------------------------------------------------------------
# 工作区文件
# -----------------------------------------------------------------------------
WORKSPACES_ROOT_DIR=data/workspaces

# 每个对话最多工作区文件数（1-50）
MAX_WORKSPACE_FILES_PER_CONVERSATION=20

# 单次请求最多上传文件数（1-10）
MAX_WORKSPACE_FILES_PER_REQUEST=5

# 单个文件最大体积，单位字节（512KB-30MB）
MAX_WORKSPACE_FILE_SIZE_BYTES=10485760

# 文本分块大小（300-4000）
WORKSPACE_CHUNK_SIZE=1100

# 分块重叠字符数（0-800）
WORKSPACE_CHUNK_OVERLAP=180

# 单文件最大分块数（1-200）
WORKSPACE_MAX_CHUNKS_PER_FILE=80

# 检索返回结果数（1-10）
WORKSPACE_SEARCH_RESULT_COUNT=6

# 注入上下文最大长度（1000-24000）
WORKSPACE_CONTEXT_MAX_LENGTH=8000

# -----------------------------------------------------------------------------
# 联网搜索开关
# -----------------------------------------------------------------------------
WEB_SEARCH_SERVER_ENABLED=true
WEB_SEARCH_DEFAULT_ENABLED=false
WEB_SEARCH_DIRECT_URL_ENABLED=true

WEB_SEARCH_MAX_QUERIES=3
WEB_SEARCH_FETCH_PAGE_COUNT=3
WEB_SEARCH_PAGE_TIMEOUT_MS=8000
WEB_SEARCH_MIN_SCORE=0.12
WEB_SEARCH_FAILURE_NOTICE_ENABLED=true

# -----------------------------------------------------------------------------
# 应用访问 SearXNG 的配置
# -----------------------------------------------------------------------------
SEARXNG_BASE_URL=http://127.0.0.1:8080
SEARXNG_FALLBACK_BASE_URL=
SEARXNG_SEARCH_PATH=/search
SEARXNG_RESULT_COUNT=5
SEARXNG_TIMEOUT_MS=12000
SEARXNG_SNIPPET_MAX_LENGTH=320
SEARXNG_CONTEXT_MAX_LENGTH=7200
SEARXNG_LANGUAGE=
SEARXNG_SAFESEARCH=
SEARXNG_USER_AGENT=Mozilla/5.0 (compatible; wssxzh-ai-chat-web/1.0; +https://github.com/wssxzh/aichat)
GITHUB_API_BASE_URL=https://api.github.com

# -----------------------------------------------------------------------------
# 仓库内置 SearXNG 容器自身配置
# -----------------------------------------------------------------------------
SEARXNG_INSTANCE_NAME=aichat-searxng
SEARXNG_PUBLIC_BASE_URL=http://localhost:8080/
SEARXNG_SECRET=change-this-searxng-secret-key
