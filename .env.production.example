# AI Chat 生产环境配置模板
# 使用方式：复制为 ".env.production" 后，再执行 docker compose 启动。
# 注意：所有占位密钥和占位密码在首次上线前都必须替换。
# 说明：留空通常表示“可选”或“关闭”，除非注释里单独说明。

# -----------------------------------------------------------------------------
# 上游模型接口
# -----------------------------------------------------------------------------
# 必填。OpenAI 兼容接口的基础地址。
API_BASE_URL=https://api.example.com

# 必填。请替换成真实生产密钥。
API_KEY=replace-with-real-key

# -----------------------------------------------------------------------------
# HTTP 服务监听
# -----------------------------------------------------------------------------
# 容器环境通常保持 0.0.0.0，不建议随意修改。
HOST=0.0.0.0
PORT=3000

# -----------------------------------------------------------------------------
# 默认管理员账号
# -----------------------------------------------------------------------------
# 应用启动时会确保默认管理员存在。
ADMIN_USERNAME=admin

# 必填。上线前请替换成高强度密码。
ADMIN_PASSWORD=replace-with-strong-password

# -----------------------------------------------------------------------------
# 登录会话与安全
# -----------------------------------------------------------------------------
# 登录会话有效期，单位毫秒。默认 8 小时。
SESSION_TTL_MS=28800000

# 对外通过 HTTPS 提供服务时，应保持 true。
SESSION_COOKIE_SECURE=true

# -----------------------------------------------------------------------------
# 运行时数据文件
# -----------------------------------------------------------------------------
# Docker 生产环境建议统一落到挂载的 /data 卷中。
RUNTIME_CONFIG_PATH=/data/runtime-config.json
USERS_CONFIG_PATH=/data/runtime-users.json
ANNOUNCEMENTS_CONFIG_PATH=/data/runtime-announcements.json
CONVERSATIONS_CONFIG_PATH=/data/runtime-conversations.json

# 持久化数据保留上限。
MAX_STORED_ANNOUNCEMENTS=80
MAX_STORED_CONVERSATIONS_PER_USER=120

# -----------------------------------------------------------------------------
# 联网搜索功能开关
# -----------------------------------------------------------------------------
# 服务端联网增强总开关。
WEB_SEARCH_SERVER_ENABLED=true

# 前端首次访问时，Web 开关的默认状态。
WEB_SEARCH_DEFAULT_ENABLED=false

# 当用户消息里包含 GitHub 仓库链接时，是否启用直连解析。
WEB_SEARCH_DIRECT_URL_ENABLED=true

# 单次请求最多派生多少个搜索查询变体。
WEB_SEARCH_MAX_QUERIES=3

# 最多抓取多少个结果页面正文，用于补充上下文。
WEB_SEARCH_FETCH_PAGE_COUNT=3

# 单个结果页面抓取超时，单位毫秒。
WEB_SEARCH_PAGE_TIMEOUT_MS=8000

# 搜索结果筛选时使用的最低分数阈值。
WEB_SEARCH_MIN_SCORE=0.12

# 联网失败时，是否明确告诉模型“本次未成功联网”。
WEB_SEARCH_FAILURE_NOTICE_ENABLED=true

# -----------------------------------------------------------------------------
# 应用访问 SearXNG 的客户端配置
# -----------------------------------------------------------------------------
# 在 docker-compose 中，应用应通过内部服务名访问 SearXNG。
SEARXNG_BASE_URL=http://searxng:8080

# 可选备用 SearXNG 地址。
SEARXNG_FALLBACK_BASE_URL=

# SearXNG 搜索接口路径。
SEARXNG_SEARCH_PATH=/search

# 单次搜索最多保留多少条结果。
SEARXNG_RESULT_COUNT=5

# 搜索请求超时，单位毫秒。
SEARXNG_TIMEOUT_MS=12000

# 可选语言参数，例如 zh-CN 或 en-US。
SEARXNG_LANGUAGE=

# 可选安全搜索参数，具体取值由你的 SearXNG 配置决定。
SEARXNG_SAFESEARCH=

# 访问 SearXNG 和抓取网页时使用的 User-Agent。
SEARXNG_USER_AGENT=Mozilla/5.0 (compatible; wssxzh-ai-chat-web/1.0; +https://github.com/wssxzh/aichat)

# GitHub 仓库直连解析时使用的 GitHub API 地址。
GITHUB_API_BASE_URL=https://api.github.com

# -----------------------------------------------------------------------------
# SearXNG 容器自身配置
# -----------------------------------------------------------------------------
# 这些值由 docker-compose 在启动仓库内置的 SearXNG 服务时读取。
SEARXNG_INSTANCE_NAME=aichat-searxng

# SearXNG 服务对外声明的公开地址。
SEARXNG_PUBLIC_BASE_URL=http://localhost:8080/

# 必填。上线前请替换成足够长的随机密钥。
SEARXNG_SECRET=change-this-searxng-secret-key
